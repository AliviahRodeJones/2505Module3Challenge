@page
@model Module3Challenge.Pages.IndexModel
@{
    ViewData["Title"] = "Zoo Visitors App";
}

<h1>Welcome to the Zoo Visitors App</h1>

<form method="post">

    <label>Enter the animal's hunger level (1-10):</label>
    <input type="number" name="hungerLevel" min="1" max="10" required />

    <!-- Added an input element with a type, name, min and max -->
    <br><br>

    <label>"Enter the day of the week (1-7 where 1 is Sunday):"</label>
    <!-- Added a label with a descriptive title -->
    <input type="number" name="dayOfWeek" min="1" max="7" required />
    <!-- Added an input with a type, name, min and max -->

    <br><br>
    <button type="submit">Submit!</button>
    <!-- Added a button with a type and a descriptive title -->
    </form>

@if (Model.HungerMessage != string.Empty){
    <p>@Model.HungerMessage</p>
    <p>@Model.SoundMessage</p>
    <p>@Model.DayMessage</p>
}
<!-- Add an if statement here to check if Model.HungerMessage is not empty -->
<!-- If it's not empty, display the three messages in paragraphs or divs -->
