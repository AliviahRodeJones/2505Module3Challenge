@page
@model Module3Challenge.Pages.IndexModel
@{
    ViewData["Title"] = "Zoo Visitors App";
}

<h1>Welcome to the Zoo Visitors App</h1>

<!-- This is a form that gets info from the user -->
<form method="post">

    <label>Enter the animal's hunger level (1-10):</label>
    <!-- A label with user directions for the input below -->
    <input type="number" name="hungerLevel" min="1" max="10" required />
    <!-- Added an input element for the variable hungerLevel with a type, name, min and max -->

    <br><br>

    <label>"Enter the day of the week (1-7 where 1 is Sunday):"</label>
    <!-- Added a label with user directions for the input below -->
    <input type="number" name="dayOfWeek" min="1" max="7" required />
    <!-- Added an input element for the variable dayOfWeek with a type, name, min and max -->

    <br><br>

    <button type="submit">Submit!</button>
    <!-- Added a button with a type and a descriptive title -->

    </form>

@if (Model.HungerMessage != string.Empty){
    <p>@Model.HungerMessage</p>
    <p>@Model.SoundMessage</p>
    <p>@Model.DayMessage</p>
}
<!-- This statement checks if HungerMessage isn't an empty string. If not, the 
program displays the three messages from the C# variables
 Model.HungerMessage, Model.SoundMessage, and Model.DayMessage -->